{
  "name": "dsh-plugin-agentflow",
  "version": "0.3.1",
  "description": "DeepSeek Harness tool plugin: run AgentFlow (material-canvas agent orchestrator) boards from the model",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "cordis-plugin",
    "agentflow",
    "agent-orchestration",
    "workflow",
    "dag",
    "canvas",
    "ai-agent",
    "llm-tools",
    "agent-tools"
  ],
  "author": "CC ZHAO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CC19990113/dsh-plugin-agentflow.git"
  },
  "homepage": "https://github.com/CC19990113/dsh-plugin-agentflow#readme",
  "bugs": "https://github.com/CC19990113/dsh-plugin-agentflow/issues",
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && node --check lib/bridge.js && node --check scripts/sync-runtime.mjs && tsc --noEmit",
    "test": "node test/bridge.selftest.mjs && node test/client.selftest.mjs",
    "build": "node scripts/build-client.mjs",
    "sync": "node scripts/sync-runtime.mjs"
  },
  "type": "module",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "runtime/**",
    "cordis.patch.yml",
    "scripts/**/*.mjs",
    "docs/images/*.png",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "antd": "^6.6.6",
    "lucide-react": "^1.60.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
